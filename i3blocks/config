# i3blocks config file
#
# Please see man i3blocks for a complete reference!
# The man page is also hosted at http://vivien.github.io/i3blocks
#
# List of valid properties:
#
# align
# color
# command
# full_text
# instance
# interval
# label
# min_width
# name
# separator
# separator_block_width
# short_text
# signal
# urgent

# Global properties
#
# The top properties below are applied to every block, but can be overridden.
# Each block command defaults to the script name to avoid boilerplate.
# Change $SCRIPT_DIR to the location of your scripts!
command=$SCRIPT_DIR/$BLOCK_NAME
separator_block_width=15
markup=none
# Volume indicator
#
# The first parameter sets the step (and units to display)
# The second parameter overrides the mixer selection
# See the script for details.

# Date Time
#
[time]
align=center
command=date '+%Y-%m-%d %H:%M:%S'
interval=5

[gpu-load]
command=$SCRIPT_DIR/gpu-load/gpu-load
label=GPU
interval=5
#min_width=GPU 100% 100% 100% 100%
GPU_BRAND=NVIDIA
T_WARN=70
T_CRIT=90

[volume-pulseaudio]
command=$SCRIPT_DIR/volume-pulseaudio/volume-pulseaudio
interval=1
signal=10
STEP=5%

# Memory usage
#
# The type defaults to "mem" if the instance is not specified.
[memory]
command=$SCRIPT_DIR/memory/memory
label=MEM
separator=false
interval=30

[memory]
label=SWAP
instance=swap
separator=false
interval=30

# Disk usage
#
# The directory defaults to $HOME if the instance is not specified.
# The script may be called with a optional argument to set the alert
# (defaults to 10 for 10%).
[disk]
label=HOME
#DIR=/mnt/data
interval=30

# Network interface monitoring
#
# If the instance is not specified, use the interface used for default route.
# The address can be forced to IPv4 or IPv6 with -4 or -6 switches.
[iface]
#IFACE=wlan0
color=#00FF00
interval=10
separator=false

[wifi]
#command=$SCRIPT_DIR/wifi/wifi
#INTERFACE=wlp3s0
label=wifi:
interval=10
separator=false

[speedtest]
command=$SCRIPT_DIR/speedtest/speedtest
interval=300
#separator=true
# CPU usage
#
# The script may be called with -w and -c switches to specify thresholds,
# see the script for details.
[cpu_usage]
command=$SCRIPT_DIR/cpu_usage/cpu_usage
label=CPU
interval=10
min_width=CPU 100.00%
#separator=false

[load_average]
#command=$SCRIPT_DIR/load_average/load_average
label=LOAD
interval=10

# Battery indicator
#
# The battery instance defaults to 0.
[battery]
label=BAT
#label=⚡
interval=30

[monitors]
command=$SCRIPT_DIR/monitor_manager/monitor_manager
interval=once
#SHOW_ON_OFF=1
#SHOW_NAMES=1
#SHOW_PRIMARY=1
#SHOW_MODE=1
#SHOW_BLANKED=1
#SHOW_DUPLICATE=1
#SHOW_ROTATION=1
#SHOW_REFLECTION=1
#SHOW_BRIGHTNESS=1
#SHOW_BRIGHTNESS_VALUE=0
#SHOW_UP_DOWN=1
#FONT_FAMILY=DejaVu Sans Mono
#FONT_SIZE=11
#CLOSE_TO_BOUNDARY_BUFFER=20

# Generic media player support
#
# This displays "ARTIST - SONG" if a music is playing.
# Supported players are: spotify, vlc, audacious, xmms2, mplayer, and others.
# Set to %any to automatically pick (Requires playerctl >=2.1.1)
[mediaplayer]
# This picks any player, with vlc as first, and spotify as last choice
command=$SCRIPT_DIR/mediaplayer/mediaplayer
instance=vlc,%any,spotify
interval=5
signal=10

# OpenVPN support
#
# Support multiple VPN, with colors.
