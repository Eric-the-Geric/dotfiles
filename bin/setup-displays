#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")
host_file="$repo_dir/.local-host"
[[ -f $host_file ]] || exit 0
host=$(<"$host_file")
case "$host" in
  pop|arch) exec "$repo_dir/hosts/$host/displays.sh" ;;
  *) printf 'Unknown host profile: %s\n' "$host" >&2; exit 1 ;;
esac
